# ---------- Gmail SMTP (contact form) ----------
# 1. Turn on 2-Step Verification for the Gmail account.
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Copy this file to .env.local (and add the same values in Vercel > Settings > Environment Variables).

# The Gmail address that sends the emails
GMAIL_USER=yourname@gmail.com
# 16-character App Password (spaces are fine, they are stripped)
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Where estimate requests are delivered (comma-separated for several). Defaults to GMAIL_USER.
CONTACT_TO=
# Send the customer a "we got your request" email when they give an address (true/false)
SEND_CONFIRMATION=true

# Public site URL, used for social share images
NEXT_PUBLIC_SITE_URL=https://wildwesthardscapes.com
